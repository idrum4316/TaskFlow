# ── Docker Compose Environment ──────────────────────────
# Copy this file to .env and fill in the values.

# CouchDB credentials
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me-to-a-strong-password

# JWT signing secret (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Port the app is exposed on (host side)
APP_PORT=3000

# Set this if accessing the app from a different origin (leave empty when serving client from the same host)
CLIENT_ORIGIN=

# Meilisearch credentials
MEILISEARCH_API_KEY=change-me-to-a-strong-meili-key
